# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
roadwatch_ai_venv/

# Large Datasets and Archives (Do not commit to Git)
*.zip
*.tar
*.tar.gz
*.tgz
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/dataset.yaml
!data/dataset_boosted.yaml

# Training runs & caches
runs/
outputs/train/
outputs/predictions/*
!outputs/predictions/.gitkeep
*.cache

# Model Weights: Include trained production weights (6.2 MB), ignore intermediate checkpoints
models/*
!models/best.pt
!models/.gitkeep

# Metrics and Plots: Preserve genuine evaluation results
!outputs/metrics/*.json
!outputs/metrics/*.csv
!outputs/plots/*.png

# Credentials, secrets and environment variables
.env
*.env
*.key
*.pem
secrets.toml

# OS and Editor artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

yolov8n.pt

